# Copy to env.sh at the repository root, then source it to use the isolated toolchains in tools/
W="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export RUSTUP_HOME=$W/tools/rustup CARGO_HOME=$W/tools/cargo ELAN_HOME=$W/tools/elan OPAMROOT=$W/tools/opam
export PATH=$W/tools/bin:$CARGO_HOME/bin:$ELAN_HOME/bin:$W/charon-pinned/bin:$W/aeneas/bin:$PATH
eval "$(opam env --root=$OPAMROOT --switch=default --set-root --set-switch 2>/dev/null)"
export AENEAS_EXTRA="${AENEAS_EXTRA:-}"

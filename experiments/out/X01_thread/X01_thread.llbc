let's explain them:"},{"DocComment":""},{"DocComment":" - The `'static` constraint means that the closure and its return value"},{"DocComment":"   must have a lifetime of the whole program execution. The reason for this"},{"DocComment":"   is that threads can outlive the lifetime they have been created in."},{"DocComment":""},{"DocComment":"   Indeed if the thread, and by extension its return value, can outlive their"},{"DocComment":"   caller, we need to make sure that they will be valid afterwards, and since"},{"DocComment":"   we *can't* know when it will return we need to have them valid as long as"},{"DocComment":"   possible, that is until the end of the program, hence the `'static`"},{"DocComment":"   lifetime."},{"DocComment":" - The [`Send`] constraint is because the closure will need to be passed"},{"DocComment":"   *by value* from the thread where it is spawned to the new thread. Its"},{"DocComment":"   return value will need to be passed from the new thread to the thread"},{"DocComment":"   where it is `join`ed."},{"DocComment":"   As a reminder, the [`Send`] marker trait expresses that it is safe to be"},{"DocComment":"   passed from thread to thread. [`Sync`] expresses that it is safe to have a"},{"DocComment":"   reference be passed from thread to thread."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the OS fails to create a thread; use [`Builder::spawn`]"},{"DocComment":" to recover from such errors."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Creating a thread."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let handler = thread::spawn(|| {"},{"DocComment":"     // thread code"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" handler.join().unwrap();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" As mentioned in the module documentation, threads are usually made to"},{"DocComment":" communicate using [`channels`], here is how it usually looks."},{"DocComment":""},{"DocComment":" This example also shows how to use `move`, in order to give ownership"},{"DocComment":" of values to a thread."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::thread;"},{"DocComment":" use std::sync::mpsc::channel;"},{"DocComment":""},{"DocComment":" let (tx, rx) = channel();"},{"DocComment":""},{"DocComment":" let sender = thread::spawn(move || {"},{"DocComment":"     tx.send(\"Hello, thread\".to_owned())"},{"DocComment":"         .expect(\"Unable to send on channel\");"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" let receiver = thread::spawn(move || {"},{"DocComment":"     let value = rx.recv().expect(\"Unable to receive from channel\");"},{"DocComment":"     println!(\"{value}\");"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" sender.join().expect(\"The sender thread has panicked\");"},{"DocComment":" receiver.join().expect(\"The receiver thread has panicked\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A thread can also return a value through its [`JoinHandle`], you can use"},{"DocComment":" this to make asynchronous computations (futures might be more appropriate"},{"DocComment":" though)."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let computation = thread::spawn(|| {"},{"DocComment":"     // Some expensive computation."},{"DocComment":"     42"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" let result = computation.join().unwrap();"},{"DocComment":" println!(\"{result}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Notes"},{"DocComment":""},{"DocComment":" This function has the same minimal guarantee regarding \"foreign\" unwinding operations (e.g."},{"DocComment":" an exception thrown from C++ code, or a `panic!` in Rust code compiled or linked with a"},{"DocComment":" different runtime) as [`catch_unwind`]; namely, if the thread created with `thread::spawn`"},{"DocComment":" unwinds all the way to the root with such an exception, one of two behaviors are possible,"},{"DocComment":" and it is unspecified which will occur:"},{"DocComment":""},{"DocComment":" * The process aborts."},{"DocComment":" * The process does not abort, and [`join`] will return a `Result::Err`"},{"DocComment":"   containing an opaque type."},{"DocComment":""},{"DocComment":" [`catch_unwind`]: ../../std/panic/fn.catch_unwind.html"},{"DocComment":" [`channels`]: crate::sync::mpsc"},{"DocComment":" [`join`]: JoinHandle::join"},{"DocComment":" [`Err`]: crate::result::Result::Err"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":19,"beg":{"line":124,"col":17},"end":{"line":124,"col":29}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Contravariant"},{"index":1,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[17,{"data":{"file_id":19,"beg":{"line":127,"col":7},"end":{"line":127,"col":20}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Deduplicated":35},{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[18,{"data":{"file_id":19,"beg":{"line":128,"col":7},"end":{"line":128,"col":11}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[19,{"data":{"file_id":19,"beg":{"line":129,"col":7},"end":{"line":129,"col":11}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":6}},"Static"]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":7}},"Static"]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6}],"output":{"Value":[45,{"Adt":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":7}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":22,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["thread",0]},{"Ident":["join_handle",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3},"kind":"InherentImplBlock"}}},{"Ident":["join",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":149,"col":4},"end":{"line":149,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Waits for the associated thread to finish."},{"DocComment":""},{"DocComment":" This function will return immediately if the associated thread has already finished."},{"DocComment":" Otherwise, it fully waits for the thread to finish, including all destructors"},{"DocComment":" for thread-local variables that might be running after the main function of the thread."},{"DocComment":""},{"DocComment":" In terms of [atomic memory orderings], the completion of the associated"},{"DocComment":" thread synchronizes with this function returning. In other words, all"},{"DocComment":" operations performed by that thread [happen"},{"DocComment":" before](https://doc.rust-lang.org/nomicon/atomics.html#data-accesses) all"},{"DocComment":" operations that happen after `join` returns."},{"DocComment":""},{"DocComment":" If the associated thread panics, [`Err`] is returned with the parameter given"},{"DocComment":" to [`panic!`] (though see the Notes below)."},{"DocComment":""},{"DocComment":" [`Err`]: crate::result::Result::Err"},{"DocComment":" [atomic memory orderings]: crate::sync::atomic"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function may panic on some platforms if a thread attempts to join"},{"DocComment":" itself or otherwise may create a deadlock with joining threads."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let builder = thread::Builder::new();"},{"DocComment":""},{"DocComment":" let join_handle: thread::JoinHandle<_> = builder.spawn(|| {"},{"DocComment":"     // some work here"},{"DocComment":" }).unwrap();"},{"DocComment":" join_handle.join().expect(\"Couldn't join on the associated thread\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Notes"},{"DocComment":""},{"DocComment":" If a \"foreign\" unwinding operation (e.g. an exception thrown from C++"},{"DocComment":" code, or a `panic!` in Rust code compiled or linked with a different"},{"DocComment":" runtime) unwinds all the way to the thread root, the process may be"},{"DocComment":" aborted; see the Notes on [`thread::spawn`]. If the process is not"},{"DocComment":" aborted, this function will return a `Result::Err` containing an opaque"},{"DocComment":" type."},{"DocComment":""},{"DocComment":" [`catch_unwind`]: ../../std/panic/fn.catch_unwind.html"},{"DocComment":" [`thread::spawn`]: super::spawn"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signatu
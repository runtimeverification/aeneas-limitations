":""},{"DocComment":" ```"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let builder = thread::Builder::new();"},{"DocComment":""},{"DocComment":" let join_handle: thread::JoinHandle<_> = builder.spawn(|| {"},{"DocComment":"     // some work here"},{"DocComment":" }).unwrap();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A thread being detached and outliving the thread that spawned it:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::thread;"},{"DocComment":" use std::time::Duration;"},{"DocComment":""},{"DocComment":" let original_thread = thread::spawn(|| {"},{"DocComment":"     let _detached_thread = thread::spawn(|| {"},{"DocComment":"         // Here we sleep to make sure that the first thread returns before."},{"DocComment":"         thread::sleep(Duration::from_millis(10));"},{"DocComment":"         // This will be called, even though the JoinHandle is dropped."},{"DocComment":"         println!(\"♫ Still alive ♫\");"},{"DocComment":"     });"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" original_thread.join().expect(\"The thread being joined has panicked\");"},{"DocComment":" println!(\"Original thread is joined.\");"},{"DocComment":""},{"DocComment":" // We make sure that the new thread has time to run, before the main"},{"DocComment":" // thread returns."},{"DocComment":""},{"DocComment":" thread::sleep(Duration::from_millis(1000));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`thread::Builder::spawn`]: super::Builder::spawn"},{"DocComment":" [`thread::spawn`]: super::spawn"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unk
rom_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["as_mut_slice",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["Index",0]}]},{"key":{"Type":9},"value":[{"Ident":["MaybeUninit",0]}]},{"key":{"Type":10},"value":[{"Ident":["ManuallyDrop",0]}]},{"key":{"Fun":32},"value":[{"Ident":["new_uninit",0]}]},{"key":{"TraitDecl":4},"value":[{"Ident":["Destruct",0]}]},{"key":{"Fun":22},"value":[{"Ident":["mac",0]}]},{"key":{"Fun":24},"value":[{"Ident":["ins",0]}]},{"key":{"Fun":25},"value":[{"Ident":["ext",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["Clone",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["SliceIndex",0]}]},{"key":{"Type":6},"value":[{"Ident":["Vec",0]}]},{"key":{"Type":7},"value":[{"Ident":["Global",0]}]},{"key":{"Fun":43},"value":[{"Ident":["into_vec",0]}]},{"key":{"Fun":41},"value":[{"Ident":["write",0]}]},{"key":{"Fun":42},"value":[{"Ident":["assume_init",0]}]},{"key":{"Type":5},"value":[{"Ident":["Option",0]}]},{"key":{"Fun":0},"value":[{"Ident":["as_slice",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["IndexMut",0]}]},{"key":{"Fun":2},"value":[{"Ident":["repeat",0]}]},{"key":{"Fun":36},"value":[{"Ident":["remove",0]}]},{"key":{"TraitDecl":5},"value":[{"Ident":["Copy",0]}]},{"key":{"Fun":28},"value":[{"Ident":["push",0]}]},{"key":{"Type":8},"value":[{"Ident":["Box",0]}]},{"key":{"Fun":23},"value":[{"Ident":["zeros",0]}]},{"key":{"Fun":33},"value":[{"Ident":["box_assume_init_into_vec_unsafe",0]}]},{"key":{"Fun":35},"value":[{"Ident":["insert",0]}]},{"key":{"Type":4},"value":[{"Ident":["Range",0]}]},{"key":{"Fun":26},"value":[{"Ident":["clone_from",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Builtin":[{"Tuple":0},0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":
 output at this location, without"},{"DocComment":" performing any bounds checking."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Calling this method with an out-of-bounds index or a dangling `slice` pointer"},{"DocComment":" is *[undefined behavior]* even if the resulting pointer is not used."},{"DocComment":""},{"DocComment":" [undefined behavior]: https://doc.rust-lang.org/reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6},{"Value":[77,{"RawPtr":[{"Deduplicated":7},"Mut"]}]}],"output":{"Value":[78,{"RawPtr":[{"Deduplicated":14},"Mut"]}]}},"default":null},"kind":{"TraitMethod":[2,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":7}},{"Var":{"Bound":[1,0]}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":14}},{"Var":{"Bound":[1,0]}}]}],"trait_type_constraints":[]},"skip_binder":{"name":"index","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["index",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":167,"col":4},"end":{"line":167,"col":47}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a shared reference to the output at this location, panicking"},{"DocComment":" if out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":4,"beg":{"line":166,"col":4},"end":{"line":166,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"
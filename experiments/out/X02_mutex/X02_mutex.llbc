t":" Instead, prefer to use [the `?` (try) operator][try-operator], or pattern matching"},{"DocComment":" to handle the [`Err`] case explicitly, or call [`unwrap_or`],"},{"DocComment":" [`unwrap_or_else`], or [`unwrap_or_default`]."},{"DocComment":""},{"DocComment":" [panic-abort]: https://doc.rust-lang.org/book/ch09-01-unrecoverable-errors-with-panic.html"},{"DocComment":" [try-operator]: https://doc.rust-lang.org/book/ch09-02-recoverable-errors-with-result.html#a-shortcut-for-propagating-errors-the--operator"},{"DocComment":" [`unwrap_or`]: Result::unwrap_or"},{"DocComment":" [`unwrap_or_else`]: Result::unwrap_or_else"},{"DocComment":" [`unwrap_or_default`]: Result::unwrap_or_default"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the value is an [`Err`], with a panic message provided by the"},{"DocComment":" [`Err`]'s value."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x: Result<u32, &str> = Ok(2);"},{"DocComment":" assert_eq!(x.unwrap(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let x: Result<u32, &str> = Err(\"emergency failure\");"},{"DocComment":" x.unwrap(); // panics with `emergency failure`"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":15,"beg":{"line":1224,"col":4},"end":{"line":1224,"col":19}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[19,{"data":{"file_id":15,"beg":{"line":1228,"col":11},"end":{"line":1228,"col":21}},"generated_from_span"
.=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Range","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":89,"col":4},"end":{"line":89,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","is_positional":false,"ty":{"Value":[6,{"TypeVar":{"Free":0}}]}},{"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":92,"col":4},"end":{"line":92,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Deduplicated":6}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Value":[2,{"AtLeast":{"Value":[3,{"AlignTo":{"base":{"Value":[4,{"Max":[{"Value":[5,{"Plus":[{"Value":[6,{"Constant":{"Value":[3,[{"OffsetOf":[{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Deduplicated":0}]]}}]},{"Value":[7,{"Constant":{"Value":[4,[{"SizeOf":{"Deduplicated":6}},{"Deduplicated":0}]]}}]}]}]},{"Value":[8,{"Plus":[{"Value":[9,{"Constant":{"Value":[5,[{"OffsetOf":[{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]},"builtin":null},null,1]},{"Deduplicated":0}]]}}]},{"Deduplicated":7}]}]}]}]},"target_align":{"Value":[10,{"Max":[{"Value":[11,{"Constant":{"Value":[6,[{"AlignOf":{"Deduplicated":6}},{"Deduplicated":0}]]}}]},{"Deduplicated":11}]}]}}}]}}]}},"align":{"chosen":null,"guarantee
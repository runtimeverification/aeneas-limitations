:null,"attr_info":{"attributes":[{"DocComment":" A double-ended queue implemented with a growable ring buffer."},{"DocComment":""},{"DocComment":" The \"default\" usage of this type as a queue is to use [`push_back`] to add to"},{"DocComment":" the queue, and [`pop_front`] to remove from the queue. [`extend`] and [`append`]"},{"DocComment":" push onto the back in this manner, and iterating over `VecDeque` goes front"},{"DocComment":" to back."},{"DocComment":""},{"DocComment":" A `VecDeque` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let deq = VecDeque::from([-1, 0, 1]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since `VecDeque` is a ring buffer, its elements are not necessarily contiguous"},{"DocComment":" in memory. If you want to access the elements as a single slice, such as for"},{"DocComment":" efficient sorting, you can use [`make_contiguous`]. It rotates the `VecDeque`"},{"DocComment":" so that its elements do not wrap, and returns a mutable slice to the"},{"DocComment":" now-contiguous element sequence."},{"DocComment":""},{"DocComment":" [`push_back`]: VecDeque::push_back"},{"DocComment":" [`pop_front`]: VecDeque::pop_front"},{"DocComment":" [`extend`]: VecDeque::extend"},{"DocComment":" [`append`]: VecDeque::append"},{"DocComment":" [`make_contiguous`]: VecDeque::make_contiguous"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"VecDeque","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":7,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":59,"col":0},"end":{"line":59,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The global memory allocator."},{"DocComment":""},{"DocComment":" This type implements the [`Allocator`] trait by forwarding calls"},{"DocComment":" to the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" Note: while this type is unstable, the functionality it provides can be"},{"DocComment":" accessed through the [free functions in `alloc`](self#functions)."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"GlobalAlloc","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":{"Value":[18,{"AtLeast":{"Deduplicated":0}}]}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Value":[19,{"AtLeast":{"Deduplicated":1}}]}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"union_chunks":null,"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":8,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["btree",0]},{"Ident":["map",0]},{"Ident":["BTreeMap",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":189,"col":0},"end":{"line":193,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An ordered map based on a [B-Tree]."},{"DocComment":""},{"DocComment":" Given a key type with a [total order], an ordered map stores its entries in key order."},{"DocComment":" That means that keys must be of a type that implements the [`Ord`] trait,"},{"DocComment":" such that two keys can always be compared to determine their [`Ordering`]."},{"DocComment":" Examples of keys with a total order are strings with lexicographical order,"},{"DocComment":" and numbers with their natural order."},{"DocComment":""},{"DocComment":" Iterators obtained from functions such as [`BTreeMap::iter`], [`BTreeMap::into_iter`], [`BTreeMap::values`], or"},{"DocComment":" [`BTreeMap::keys`] produce their items in key order, and take worst-case logarithmic and"},{"DocComment":" amortized constant time per item returned."},{"DocComment":""},{"DocComment":" It is a logic error for a key to be modified in such a way that the key's ordering relative to"},{"DocComment":" any other key, as determined by the [`Ord`] trait, changes while it is in the map. This is"},{"DocComment":" normally only possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":" The behavior resulting from such a logic error is not specified, but will be encapsulated to the"},{"DocComment":" `BTreeMap` that observed the logic error and not result in undefined behavior. This could"},{"DocComment":" include panics, incorrect results, aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `BTreeMap<&str, &str>` in this example)."},{"DocComment":" let mut movie_reviews = BTreeMap::new();"},{"DocComment":""},{"DocComment":" // review some movies."},{"DocComment":" movie_reviews.insert(\"Office Space\",       \"Deals with real issues in the workplace.\");"},{"DocComment":" movie_reviews.insert(\"Pulp Fiction\",       \"Masterpiece.\");"},{"DocComment":" movie_reviews.insert(\"The Godfather\",      \"Very enjoyable.\");"},{"DocComment":" movie_reviews.insert(\"The Blues Brothers\", \"Eye lyked it a lot.\");"},{"DocComment":""},{"DocComment":" // check for a specific one."},{"DocComment":" if !movie_reviews.contains_key(\"Les Misérables\") {"},{"DocComment":"     println!(\"We've got {} reviews, but Les Misérables ain't one.\","},{"DocComment":"              movie_reviews.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // oops, this review has a lot of spelling mistakes, let's delete it."},{"DocComment":" movie_reviews.remove(\"The Blues Brothers\");"},{"DocComment":""},{"DocComment":" // look up the values associated with some keys."},{"DocComment":" let to_find = [\"Up!\", \"Office Space\"];"},{"DocComment":" for movie in &to_find {"},{"DocComment":"     match movie_reviews.get(movie) {"},{"DocComment":"        Some(review) => println!(\"{movie}: {review}\"),"},{"DocComment":"        None => println!(\"{movie} is unreviewed.\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Look up the value for a key (will panic if the key is not found)."},{"DocComment":" println!(\"Movie review: {}\", movie_reviews[\"Office Space\"]);"},{"DocComment":""},{"DocComment":" // iterate over everything."},{"DocComment":" for (movie, review) in &movie_reviews {"},{"DocComment":"     println!(\"{movie}: \\\"{review}\\\"\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `BTreeMap` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeMap;"},{"DocComment":""},{"DocComment":" let solar_distance = BTreeMap::from(["},{"DocComment":"     (\"Mercury\", 0.4),"},{"DocComment":"     (\"Venus\", 0.7),"},{"DocComment":"     (\"Earth\", 1.0),"},{"DocComment":"     (\"Mars\", 1.5),"},{"DocComment":" ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Entry` API"},{"DocComment":""},{"DocComment":" `BTreeMap` implements an [`Entry API`], which allows for complex"},{"DocComment":" methods of getting, setting, updating and removing keys and their values:"},{"DocComment":""},{"DocComment":" [`Entry API`]: BTreeMap::entry"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::BTreeMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `BTreeMap<&str, u8>` in this example)."},{"DocComment":" let mut player_stats = BTreeMap::new();"},{"DocComment":""},{"DocComment":" fn random_stat_buff() -> u8 {"},{"DocComment":"     // could actually return some random value here - let's just return"},{"DocComment":"     // some fixed value for now"},{"DocComment":"     42"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // insert a key only if it doesn't already exist"},{"DocComment":" player_stats.entry(\"health\").or_insert(100);"},{"DocComment":""},{"DocComment":" // insert a key using a function that provides a new value only if it"},{"DocComment":" // doesn't already exist"},{"DocComment":" player_stats.entry(\"defence\").or_insert_with(random_stat_buff);"},{"DocComment":""},{"DocComment":" // update a key, guarding against the key possibly not being set"},{"DocComment":" let stat = player_stats.entry(\"attack\").or_insert(100);"},{"DocComment":" *stat += random_stat_buff();"},{"DocComment":""},{"DocComment":" // modify an entry before an insert with in-place mutation"},{"DocComment":" player_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Background"},{"DocComment":""},{"DocComment":" A B-tree is (like) a [binary search tree], but adapted to the natural granularity that modern"},{"DocComment":" machines like to consume data at. This means that each node contains an entire array of elements,"},{"DocComment":" instead of just a single element."},{"DocComment":""},{"DocComment":" B-Trees represent a fundamental compromise between cache-efficiency and actually minimizing"},{"DocComment":" the amount of work performed in a search. In theory, a binary search tree (BST) is the optimal"},{"DocComment":" choice for a sorted map, as a perfectly balanced BST performs the theoretical minimum number of"},{"DocComment":" comparisons necessary to find an element (log<sub>2</sub>n). However, in practice the way this"},{"DocComment":" is done is *very* inefficient for modern computer architectures. In particular, every element"},{"DocComment":" is stored in its own individually heap-allocated node. This means that every single insertion"},{"DocComment":" triggers a heap-allocation, and every comparison is a potential cache-miss due to the indirection."},{"DocComment":" Since both heap-allocations and cache-misses are notably expensive in practice, we are forced to,"},{"DocComment":" at the very least, reconsider the BST strategy."},{"DocComment":""},{"DocComment":" A B-Tree instead makes each node contain B-1 to 2B-1 elements in a contiguous array. By doing"},{"DocComment":" this, we reduce the number of allocations by a factor of B, and improve cache efficiency in"},{"DocComment":" searches. However, this does mean that searches will have to do *more* comparisons on average."},{"DocComment":" The precise number of comparisons depends on the node search strategy used. For optimal cache"},{"DocComment":" efficiency, one could search the nodes linearly. For optimal comparisons, one could search"},{"DocComment":" the node using binary search. As a compromise, one could also perform a linear search"},{"DocComment":" that initially only checks every i<sup>th</sup> element for some choice of i."},{"DocComment":""},{"DocComment":" Currently, our implementation simply performs naive linear search. This provides excellent"},{"DocComment":" performance on *small* nodes of elements which are cheap to compare. However in the future we"},{"DocComment":" would like to further explore choosing the optimal search strategy based on the choice of B,"},{"DocComment":" and possibly other factors. Using linear search, searching for a random element is expected"},{"DocComment":" to take B * log(n) comparisons, which is generally worse than a BST. In practice,"},{"DocComment":" however, performance is excellent."},{"DocComment":""},{"DocComment":" [B-Tree]: https://en.wikipedia.org/wiki/B-tree"},{"DocComment":" [binary search tree]: https://en.wikipedia.org/wiki/Binary_search_tree"},{"DocComment":" [total order]: https://en.wikipedia.org/wiki/Total_order"},{"DocComment":" [`Cell`]: core::cell::Cell"},{"DocComment":" [`RefCell`]: core::cell::RefCell"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"BTreeMap","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"K","variance":"Covariant"},{"index":1,"name":"V","variance":"Covariant"},{"index":2,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["Ordering",0]}],"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":420,"col":0},"end":{"line":420,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An `Ordering` is the result of a comparison between two values."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cmp::Ordering;"},{"DocComment":""},{"DocComment":" assert_eq!(1.cmp(&2), Ordering::Less);"},{"DocComment":""},{"DocComment":" assert_eq!(1.cmp(&1), Ordering::Equal);"},{"DocComment":""},{"DocComment":" assert_eq!(2.cmp(&1), Ordering::Greater);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"OrderingEnum","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":423,"col":4},"end":{"line":423,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" An ordering where a compared value is less than another."}],"inline":null,"rename":null,"public":true},"name":"Less","fields":[],"discriminant":{"Signed":["I8","-1"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":426,"col":4},"end":{"line":426,"col":9}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" An ordering where a compared value is equal to another."}],"inline":null,"rename":null,"public":true},"name":"Equal","fields":[],"discriminant":{"Signed":["I8","0"]}},{"id":2,"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":429,"col":4},"end":{"line":429,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" An ordering where a compared value is greater than another."}],"inline":null,"rename":null,"public":true},"name":"Greater","fields":[],"discriminant":{"Signed":["I8","1"]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":1},"guarantee":{"Value":[20,{"Constant":{"Value":[8,[{"SizeOf":{"Value":[12,{"Scalar":{"Integer":{"Signed":"I8"}}}]}},{"Deduplicated":0}]]}}]}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Value":[21,{"Constant":{"Value":[9,[{"AlignOf":{"Deduplicated":12}},{"Deduplicated":0}]]}}]}},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Signed":"I8"},"children":[[{"start":{"Signed":["I8","-1"]},"end":{"Signed":["I8","-1"]}},{"Known":0}],[{"start":{"Signed":["I8","0"]},"end":{"Signed":["I8","0"]}},{"Known":1}],[{"start":{"Signed":["I8","1"]},"end":{"Signed":["I8","1"]}},{"Known":2}]],"fallback":"Invalid"}},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Signed":["I8","-1"]}]]},{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Signed":["I8","0"]}]]},{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Signed":["I8","1"]}]]}],"union_chunks":null,"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":{"Signed":"I8"}}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]}],"span":{"Untagged":{"data":{"file_id":20,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut 
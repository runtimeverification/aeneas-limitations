ion is *O*(*n*)."},{"DocComment":""},{"DocComment":" Note that if you have a sorted slice, [`binary_search`] may be faster."},{"DocComment":""},{"DocComment":" [`binary_search`]: slice::binary_search"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [10, 40, 30];"},{"DocComment":" assert!(v.contains(&30));"},{"DocComment":" assert!(!v.contains(&50));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you do not have a `&T`, but some other value that you can compare"},{"DocComment":" with one (for example, `String` implements `PartialEq<str>`), you can"},{"DocComment":" use `iter().any`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [String::from(\"hello\"), String::from(\"world\")]; // slice of `String`"},{"DocComment":" assert!(v.iter().any(|e| e == \"hello\")); // search with `&str`"},{"DocComment":" assert!(!v.iter().any(|e| e == \"hi\"));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[42,{"data":{"file_id":3,"beg":{"line":2604,"col":11},"end":{"line":2604,"col":20}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":4},{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":1}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":9},{"Value":[50,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":4},"Shared"]}]}],"output":{"Deduplicated":30}},"src":{"InherentImpl":{"self_ty":{"Deduplicated":10}}},"body":"Opaque"},{"def_id":25,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3},"kind":"InherentImplBlock"}}},{"Ident":["sort",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":131,"col":4},"end":{"line":133,"col":15}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Sorts the slice in ascending order, preserving initial order of equal elements."},{"DocComment":""},{"DocComment":" This sort is stable (i.e., does not reorder equal elements) and *O*(*n* \\* log(*n*))"},{"DocComment":" worst-case."},{"DocComment":""},{"DocComment":" If the implementation of [`Ord`] for `T` does not implement a [total order], the function"},{"DocComment":" may panic; even if the function exits normally, the resulting order of elements in the slice"},{"DocComment":" is unspecified. See also the note on panicking below."},{"DocComment":""},{"DocComment":" When applicable, unstable sorting is preferred because it is generally faster than stable"},{"DocComment":" sorting and it doesn't allocate auxiliary memory. See"},{"DocComment":" [`sort_unstable`](slice::sort_unstable). The exception are partially sorted slices, which"},{"DocComment":" may be better served with `slice::sort`."},{"DocComment":""},{"DocComment":" Sorting types that only implement [`PartialOrd`] such as [`f32`] and [`f64`] require"},{"DocComment":" additional precautions. For example, `f32::NAN != f32::NAN`, which doesn't fulfill the"},{"DocComment":" reflexivity requirement of [`Ord`]. By using an alternative comparison function with"},{"DocComment":" `slice::sort_by` such as [`f32::total_cmp`] or [`f64::total_cmp`] that defines a [total"},{"DocComment":" order] users can sort slices containing floating-point values. Alternatively, if all values"},{"DocComment":" in the slice are guaranteed to be in a subset for which [`PartialOrd::partial_cmp`] forms a"},{"DocComment":" [total order], it's possible to sort the slice with `sort_by(|a, b|"},{"DocComment":" a.partial_cmp(b).unwrap())`."},{"DocComment":""},{"DocComment":" # Current implementation"},{"DocComment":""},{"DocComment":" The current implementation is based on [driftsort] by Orson Peters and Lukas Bergdoll, which"},{"DocComment":" combines the fast average case of quicksort with the fast worst case and partial run"},{"DocComment":" detection of mergesort, achieving linear time on fully sorted and reversed inputs. On inputs"},{"DocComment":" with k distinct elements, the expected time to sort the data is *O*(*n* \\* log(*k*))."},{"DocComment":""},{"DocComment":" The auxiliary memory allocation behavior depends on the input length. Short slices are"},{"DocComment":" handled without allocation, medium sized slices allocate `self.len()` and beyond that it"},{"DocComment":" clamps at `self.len() / 2`."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the implementation of [`Ord`] for `T` does not implement a [total order], or if"},{"DocComment":" the [`Ord`] implementation itself panics."},{"DocComment":""},{"DocComment":" All safe functions on slices preserve the invariant that even if the function panics, all"},{"DocComment":" original elements will remain in the slice and any possible modifications via interior"},{"DocComment":" mutability are observed in the input. This ensures that recovery code (for instance inside"},{"DocComment":" of a `Drop` or following a `catch_unwind`) will still have access to all the original"},{"DocComment":" elements. For instance, if the slice belongs to a `Vec`, the `Vec::drop` method will be able"},{"DocComment":" to dispose of all contained elements."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut v = [4, -5, 1, -3, 2];"},{"DocComment":""},{"DocComment":" v.sort();"},{"DocComment":" assert_eq!(v, [-5, -3, 1, 2, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [driftsort]: https://github.com/Voultapher/driftsort"},{"DocComment":" [total order]: https://en.wikipedia.org/wiki/Total_order"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[43,{"data":{"file_id":12,"beg":{"line":133,"col":11},"end":{"line":133,"col":14}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12}],"output":{"Deduplicated":37}},"src":{"InherentImpl":{"self_ty":{"Deduplicated":10}}},"body":"Opaque"},{"def_id":26,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3},"kind":"InherentImplBlock"}}},{"Ident":["copy_from_slice",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":4341,"col":4},"end":{"line":4343,"col":16}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Copies all elements from `src` into `self`, using a memcpy."},{"DocComment":""},{"DocComment":" The length of `src` must be the same as `self`."},{"DocComment":""},{"DocComment":" If `T` does not implement `Copy`, use [`clone_from_slice`]."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function will panic if the two slices have different lengths."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Copying two elements from a slice into another:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let src = [1, 2, 3, 4];"},{"DocComment":" let mut dst = [0, 0];"},{"DocComment":""},{"DocComment":" // Because the slices have to be the same length,"},{"DocComment":" // we slice the source slice from four elements"},{"DocComment":" // to two. It will panic if we don't do this."},{"DocComment":" dst.copy_from_slice(&src[2..]);"},{"DocComment":""},{"DocComment":" assert_eq!(src, [1, 2, 3, 4]);"},{"DocComment":" assert_eq!(dst, [3, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Rust enforces that there can only be one mutable reference with no"},{"DocComment":" immutable references to a particular piece of data in a particular"},{"DocComment":" scope. Because of this, attempting to use `copy_from_slice` on a"},{"DocComment":" single slice will result in a compile failure:"},{"DocComment":""},{"DocComment":" ```compile_fail"},{"DocComment":" let mut slice = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" slice[..2].copy_from_slice(&slice[3..]); // compile fail!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" To work around this, we can use [`split_at_mut`] to create two distinct"},{"DocComment":" sub-slices from a slice:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut slice = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let (left, right) = slice.split_at_mut(2);"},{"DocComment":"     left.copy_from_slice(&right[1..]);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(slice, [4, 5, 3, 4, 5]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`clone_from_slice`]: slice::clone_from_slice"},{"DocComment":" [`split_at_mut`]: slice::split_at_mut"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":4340,"col":4},"end":{"line":4340,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[44,{"data":{"file_id":3,"beg":{"line":4343,"col":11},"end":{"line":4343,"col":15}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":1}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12},{"Value":[51,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":10},"Shared"]}]}],"output":{"Deduplicated":37}},"src":{"InherentImpl":{"self_ty":{"Deduplicated":10}}},"body":"Opaque"},{"def_id":27,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_gene